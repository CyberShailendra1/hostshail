║  License : MIT                                               ║
╚══════════════════════════════════════════════════════════════╝

Checks Performed:
  1.  Basic Host Header Injection (reflection)
  2.  Password Reset Poisoning
  3.  Web Cache Poisoning via Host Header
  4.  Open Redirect via Host Header
  5.  SSRF via Host Header
  6.  Absolute URL Injection in Request-Line
  7.  HTTP Request Smuggling indicators
  8.  Access Control Bypass (localhost spoof)
  9.  Duplicate / Conflicting Host Headers
  10. SNI vs Host Header Mismatch (HTTPS)
  11. Response Fingerprinting

Usage:
  python3 hostshail.py -u https://target.com
  python3 hostshail.py -u https://target.com -v
  python3 hostshail.py -l targets.txt -o report.json
  python3 hostshail.py -u https://target.com --proxy http://127.0.0.1:8080
"""

import argparse
import sys
import os
import json
import socket
import ssl
import urllib.parse
from datetime import datetime
from concurrent.futures import ThreadPoolExecutor, as_completed

try:
    import requests
    from requests.packages.urllib3.exceptions import InsecureRequestWarning
    requests.packages.urllib3.disable_warnings(InsecureRequestWarning)
except ImportError:
    print("[!] requests not found. Run: pip3 install requests")
    sys.exit(1)

try:
    from colorama import Fore, Back, Style, init
    init(autoreset=True)
    COLOR = True
except ImportError:
    COLOR = False


# ── Color helpers ───────────────────────────────────────────────
def red(t):     return (Fore.RED    + Style.BRIGHT + t + Style.RESET_ALL) if COLOR else t
def green(t):   return (Fore.GREEN  + Style.BRIGHT + t + Style.RESET_ALL) if COLOR else t
def yellow(t):  return (Fore.YELLOW + Style.BRIGHT + t + Style.RESET_ALL) if COLOR else t
def cyan(t):    return (Fore.CYAN   + Style.BRIGHT + t + Style.RESET_ALL) if COLOR else t
def blue(t):    return (Fore.BLUE   + Style.BRIGHT + t + Style.RESET_ALL) if COLOR else t
def magenta(t): return (Fore.MAGENTA+ Style.BRIGHT + t + Style.RESET_ALL) if COLOR else t
def bold(t):    return (Style.BRIGHT + t + Style.RESET_ALL) if COLOR else t
def dim(t):     return (Style.DIM   + t + Style.RESET_ALL) if COLOR else t


# ── Banner ──────────────────────────────────────────────────────
BANNER = r"""
